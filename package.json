{
  "name": "gg-desktop",
  "productName": "Guild Golem",
  "version": "0.1.0",
  "private": true,
  "description": "Guild Golem's desktop app: the site in a window that can read the game's folders under Program Files",
  "author": "Guild Golem",
  "homepage": "https://guildgolem.com",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "npm run build && electron .",
    "start:dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "electron-winstaller": false
  },
  "build": {
    "appId": "com.guildgolem.desktop",
    "productName": "Guild Golem",
    "copyright": "Guild Golem",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/src/**/*",
      "assets/icon.png",
      "package.json"
    ],
    "artifactName": "Guild-Golem-Setup-${version}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Guild Golem"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false
    }
  }
}
