{
  "name": "gg-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Guild Golem's desktop app: the site in a window that can read the game's folders under Program Files",
  "author": "Guild Golem",
  "homepage": "https://guildgolem.com",
  "license": "SEE LICENSE IN LICENSE",
  "main": "dist/src/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "start": "npm run build && electron .",
    "start:dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder --win nsis"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "electron": "45.0.0",
    "electron-builder": "26.18.0",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "electron-winstaller": false
  }
}
